# 使用 QQ 官方 Bot WebSocket 连接。
DRIVER=~fastapi+~websockets+~httpx
# bot运行时监听的地址和端口
HOST=0.0.0.0
PORT=12035

# 内部图片增量 API（复用上面的 HTTP 服务，不另开端口）
# 启用时必须填写独立随机 Token，例如：python -c 'import secrets; print(secrets.token_urlsafe(32))'
RSS_IMAGE_SYNC_ENABLED=false
RSS_IMAGE_SYNC_TOKEN=
# 共享 Docker 网络名用于 Compose 插值；自定义时通过 shell 导出或写入根目录 .env。
# NSYBOT_SYNC_NETWORK=bot-sync

# QQ 官方 Bot 凭据。启动脚本会自动转换为适配器所需的 QQ_BOTS JSON。
# 群聊事件的 group_openid / member_openid 不是 QQ 号。
QQ_APP_ID=your-app-id
QQ_APP_SECRET=your-app-secret
QQ_USE_WEBSOCKET=true
QQ_C2C_GROUP_AT_MESSAGES=true
QQ_GROUP_MEMBERS=true
# 高级用法：多机器人时直接填写 QQ_BOTS JSON。完整扁平凭据优先；未填写扁平凭据时使用此值。
# QQ_BOTS='[{"id":"app-id","secret":"app-secret","intent":{"c2c_group_at_messages":true,"group_members":true},"use_websocket":true}]'

# 是否在启动时检查数据库连接，建议在生产环境中开启以避免运行时错误
ALEMBIC_STARTUP_CHECK=True

# 数据库实际地址，docker容器中建议使用绝对地址而不是相对地址
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:////app/data/db.sqlite3

# 日志级别，建议在开发环境中使用DEBUG，在生产环境中使用INFO或更高级别以减少日志输出
LOG_LEVEL=INFO

# 超级管理员 OpenID 列表。请从收到的官方群消息事件日志中取得 member_openid。
SUPERUSERS='["your-member-openid"]'

# 命令前缀列表，格式为JSON数组，包含触发命令的前缀，例如：["/", "!"]，如果不需要前缀可以设置为[""]，但不建议在生产环境中使用空前缀以避免误触发
COMMAND_START=[""]

# rsshub地址和
RSSHUB_HOST=your-rsshub-host
RSSHUB_HOST_BACK=["your-rsshub-host-back"]
# 每个实例首次请求失败后再重试3次，默认等待2/4/8秒，之后切备用源。
# Retry-After超过30秒时先冷却该实例并切备用，避免长时间阻塞其他账号。
RSS_FETCH_RETRY_BASE=2


# 机器翻译的key，trans模型名称需要根据实际使用的模型进行替换
API_KEY=your-deepseek-key
SECRET_KEY=your-deepseek-secret-key
MODEL_NAME=your-trans-model-name

# 可用性监控配置
# 发送 bot 在线消息、定时报告/清理结果的官方群 OpenID，可留空。
TARGET_GROUP_OPENID=your-group-openid
# Twitter 采集监控的 Uptime Kuma Push URL（含 /api/push/<token>），留空则不上报。
# 故障/恢复通知由 Kuma 的通知渠道发送。推送监控的心跳间隔需大于采集间隔及一轮耗时。
UT_URL=your-ut-url
DETECT_URL=your-detect-url

# 全账户采集间隔（分钟）：启动立即采集，全天运行，不依赖 QQ 在线或群订阅。
REFRESH_TIME=20
# 独立 QQ 推送检查间隔（秒）：读取已采集的数据库快照，02:00–08:00 不自动发送。
RSS_PUSH_INTERVAL=60
# 入库补偿独立运行：每60秒检查最多100条到期任务，不重新抓取RSS。
RSS_INGEST_RETRY_INTERVAL=60
RSS_INGEST_RETRY_BATCH=100
# Twitter 全部源限流/故障后的最短退避秒数；Retry-After 更长时优先采用它（最多一天）。
RSS_TWITTER_COOLDOWN=900
# 连续多少个 Twitter 账号发生全部源的网络/服务故障后暂停本轮剩余 Twitter 请求。
RSS_TWITTER_FAILURE_THRESHOLD=3
# 启动首轮按群检查上次成功推送时间；超过 20 分钟或无记录时，静默登记本轮文章。
# 首轮完成后自动关闭；也可由超管在首轮前执行 /信号否 跳过检查。
IF_FIRST_TIME_START=true

# 忽略或禁止群发的官方群 OpenID，格式为 JSON 数组。
IGNORED_GROUP_OPENIDS='[]'
BROADCAST_BAN_OPENIDS='[]'

# 定时推送（broadcast 插件）
# 群注册表：GROUP_<代号> 填写该群的 group_openid，留空则该代号不可用。
GROUP_CQU_EF=your-cqu-ef-group-openid
# 是否注册每日 12:00 / 18:00 的定时推送，默认关闭。手动触发命令「推送 CQU_EF」不受此开关限制。
CQU_EF_PUSH_ENABLED=false

# 生日插件：已在群内订阅标签后，每日北京时间 23:00 提醒手动修改/恢复群昵称。
# 原群名通过「生日 群名 <原群昵称>」设置，不依赖群资料读取或修改接口。
BIRTHDAY_REMINDER_ENABLED=true
