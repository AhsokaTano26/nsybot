# 使用 QQ 官方 Bot WebSocket 连接。
DRIVER=~fastapi+~websockets+~httpx
# bot运行时监听的地址和端口
HOST=0.0.0.0
PORT=12035

# QQ 官方 Bot 凭据。启动脚本会自动转换为适配器所需的 QQ_BOTS JSON。
# 群聊事件的 group_openid / member_openid 不是 QQ 号。
QQ_IS_SANDBOX=false
QQ_APP_ID=your-app-id
QQ_APP_SECRET=your-app-secret
# QQ 官方适配器 1.7.x 的兼容字段，通常可保持为空。
QQ_APP_TOKEN=
QQ_USE_WEBSOCKET=true
QQ_C2C_GROUP_AT_MESSAGES=true
QQ_GROUP_MEMBERS=true
# 高级用法：多机器人时直接填写 QQ_BOTS JSON。完整扁平凭据优先；未填写扁平凭据时使用此值。
# QQ_BOTS='[{"id":"app-id","token":"","secret":"app-secret","intent":{"c2c_group_at_messages":true,"group_members":true},"use_websocket":true}]'

# 是否在启动时检查数据库连接，建议在生产环境中开启以避免运行时错误
ALEMBIC_STARTUP_CHECK=True

# 数据库实际地址，docker容器中建议使用绝对地址而不是相对地址
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:////app/data/db.sqlite3

# 日志级别，建议在开发环境中使用DEBUG，在生产环境中使用INFO或更高级别以减少日志输出
LOG_LEVEL=INFO

# 超级管理员 OpenID 列表。请从收到的官方群消息事件日志中取得 member_openid。
SUPERUSERS='["your-member-openid"]'

# 命令前缀列表，格式为JSON数组，包含触发命令的前缀，例如：["/", "!"]，如果不需要前缀可以设置为[""]，但不建议在生产环境中使用空前缀以避免误触发
COMMAND_START=[""]

# rsshub地址和
RSSHUB_HOST=your-rsshub-host
RSSHUB_HOST_BACK=["your-rsshub-host-back"]


# 机器翻译的key，trans模型名称需要根据实际使用的模型进行替换
API_KEY=your-deepseek-key
SECRET_KEY=your-deepseek-secret-key
MODEL_NAME=your-trans-model-name

# 可用性监控配置
# 发送 bot 在线消息、定时报告/清理结果的官方群 OpenID，可留空。
TARGET_GROUP_OPENID=your-group-openid
# 可用性监控的URL，建议在生产环境中使用HTTPS地址以确保安全通信
UT_URL=your-ut-url
DETECT_URL=your-detect-url

# 更新时间间隔，单位为分钟，建议根据实际需求设置合理的值以平衡数据更新频率和系统负载
REFRESH_TIME=20

# 忽略或禁止群发的官方群 OpenID，格式为 JSON 数组。
IGNORED_GROUP_OPENIDS='[]'
BROADCAST_BAN_OPENIDS='[]'
